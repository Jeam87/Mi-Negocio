{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/tienda/:userId", "destination": "/tienda/:userId/index.html" },
    { "source": "/tienda/:userId/", "destination": "/tienda/:userId/index.html" },
    { "source": "/(.*)", "destination": "/api/index.py" }
  ]
}
