<!DOCTYPE html>
<html><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Mi Tienda</title><script src="https://cdn.tailwindcss.com"></script></head>
<body class="bg-gray-50 p-4">
<div class="max-w-md mx-auto bg-white rounded-2xl shadow p-5">
<h1 class="text-2xl font-bold">🛒 Mi Tienda</h1><p class="text-gray-500 mb-4 text-sm">Pide por WhatsApp - Jacona</p>
<div id="lista" class="space-y-3">Cargando...</div>
</div>
<script>
const user_id = window.location.pathname.split('/')[2];
async function cargar(){
  const res = await fetch(`https://YOUR_SUPABASE_URL/rest/v1/products?user_id=eq.${user_id}&stock=gt.0`, {
    headers: { apikey: 'TU_ANON_KEY', Authorization: 'Bearer TU_ANON_KEY' }
  });
  const data = await res.json();
  document.getElementById('lista').innerHTML = data.map(p=>`
    <div class="flex justify-between items-center border rounded-xl p-4">
      <div><b>${p.name}</b><br><span class="text-xs text-gray-400">${p.stock} disp.</span><br><span class="text-green-600 font-bold">$${p.price}</span></div>
      <a href="https://wa.me/523521009999?text=Hola, quiero: ${encodeURIComponent(p.name)}" target="_blank" class="bg-green-500 text-white px-4 py-2 rounded-full text-sm font-bold">Pedir</a>
    </div>`).join('') || 'Sin productos';
}
cargar();
</script></body></html>
